# Copy to `.env.local` and adjust. Never commit real values.

# Where the app reads data from:
#   demo — built-in simulated fixtures (default; no backend required)
#   api  — the Laravel backend at VITE_API_BASE_URL (contracts in docs/API_INTEGRATION.md)
VITE_DATA_SOURCE=demo

# Base URL of the backend REST API (used only when VITE_DATA_SOURCE=api).
VITE_API_BASE_URL=http://localhost:8000/api

# Request timeout in milliseconds for API calls.
VITE_API_TIMEOUT_MS=10000
