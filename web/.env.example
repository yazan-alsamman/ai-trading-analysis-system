# Copy to `.env.local` and adjust. Never commit real values.
#
# Everything prefixed VITE_ is compiled into the public JavaScript bundle.
# Never give a secret (JWT keys, database URLs, provider API keys) a VITE_ name.

# Where the app reads data from:
#   demo — built-in simulated fixtures (default; no backend required)
#   api  — the FastAPI backend (see docs/BACKEND_INTEGRATION_SETUP.md)
VITE_DATA_SOURCE=demo

# Backend REST base. Default `/api/v1` = same origin (production behind one Nginx,
# and local development through the Vite proxy below). An absolute URL also works,
# e.g. https://api.example.org/api/v1 — the backend's CORS_ORIGINS must then allow this site.
VITE_API_BASE_URL=/api/v1

# Live market data (WebSocket). Leave empty to derive it: /ws/market on the API's host.
VITE_WS_URL=

# Request timeout in milliseconds for API calls.
VITE_API_TIMEOUT_MS=10000

# Public site origin (canonical URLs, Open Graph, sitemap.xml). Optional; leave empty locally.
VITE_SITE_URL=

# Local development only (NOT compiled into the bundle): where `pnpm dev` / `pnpm preview`
# forward /api and /ws, so the browser stays same-origin and no CORS is needed.
BACKEND_URL=http://localhost:8000
