erDiagram
    instruments {
        uuid id PK
        varchar symbol
        varchar source
        enum_market_type market
        varchar base_asset
        varchar quote_asset
        int price_precision
        int quantity_precision
        bool is_active
        double contract_size
        double tick_size
        double lot_step
        double min_lot
        double max_lot
        varchar quote_currency
        double margin_rate
        varchar price_basis
        jsonb session_calendar
        double cost_per_unit
        varchar spec_source
        timestamptz spec_updated_at
        timestamptz created_at
        timestamptz updated_at
    }
    candles_1m {
        uuid instrument_id PK, FK
        timestamptz ts PK
        double open
        double high
        double low
        double close
        double volume
        int trades
        double spread
        varchar source
        timestamptz received_at
    }
    signals {
        uuid id PK
        uuid instrument_id FK
        string timeframe
        varchar strategy_key
        jsonb params
        varchar params_hash
        timestamptz bar_time
        enum_signal_side side
        double strength
        double price
        varchar reason
        jsonb details
        timestamptz created_at
    }
    signal_outcomes {
        uuid signal_id PK, FK
        int horizon_bars
        timestamptz exit_ts
        double exit_price
        double return_pct
        double mfe_pct
        double mae_pct
        bool correct
        double cost_per_unit
        varchar note
        timestamptz resolved_at
    }
    price_alerts {
        uuid id PK
        uuid user_id FK
        uuid instrument_id FK
        enum_price_alert_condition condition
        double value
        int window_minutes
        enum_price_alert_repeat repeat
        int cooldown_minutes
        varchar note
        bool is_active
        timestamptz last_triggered_at
        int trigger_count
        timestamptz expires_at
        timestamptz created_at
        timestamptz updated_at
    }
    economic_events {
        uuid id PK
        varchar event_key
        varchar source
        varchar currency
        varchar title
        varchar impact
        timestamptz scheduled_at
        date scheduled_date
        varchar time_label
        varchar actual
        varchar forecast
        varchar previous
        double actual_value
        double forecast_value
        double previous_value
        timestamptz fetched_at
        varchar content_hash
    }
    feed_credentials {
        varchar provider PK
        varchar env
        text access_token_enc
        text refresh_token_enc
        timestamptz expires_at
        varchar scope
        bigint account_id
        jsonb accounts
        timestamptz linked_at
        timestamptz refreshed_at
        timestamptz updated_at
    }
    users
    candles_1m }o--|| instruments : "instrument_id"
    price_alerts }o--|| instruments : "instrument_id"
    price_alerts }o--|| users : "user_id"
    signal_outcomes |o--|| signals : "signal_id"
    signals }o--|| instruments : "instrument_id"
