# انسخ هذا الملف إلى .env وعدّل القيم
ENVIRONMENT=development

POSTGRES_USER=trading
POSTGRES_PASSWORD=trading
POSTGRES_DB=trading
DATABASE_URL=postgresql+asyncpg://trading:trading@db:5432/trading
# منفذ المضيف لقاعدة البيانات و Redis (غيّره إن كان 5432/6379 مستخدماً على جهازك)
POSTGRES_PORT=5432
REDIS_PORT=6379

REDIS_URL=redis://redis:6379/0

# في الإنتاج (ENVIRONMENT=production) يجب أن يكون 32 حرفاً على الأقل وليس change-me
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# اختياري: يُنشأ هذا المدير عند الإقلاع إذا لم يوجد أي مدير
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

AI_SERVICE_URL=http://ai-service:8001
# عميل ai-service (B7، docs/ai-contract.md): مهلة كل محاولة، وإعادة المحاولة عند انتهاء المهلة أو خطأ
# الاتصال أو 5xx بنفس الطلب ونفس request_id، وعدد الشموع المرسلة لكل فريم
AI_EVALUATE_TIMEOUT_SECONDS=10
AI_SIZE_TIMEOUT_SECONDS=5
AI_EXPLAIN_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
# عدد الشموع لكل فريم (فادي: نحو 20 يوم تداول من 15m وسنة من الأيام). 1d = يوم تداول نيويورك
# 17:00 إلى 17:00 (America/New_York). التاريخ الأقصر يُرسَل كما هو ويُذكر في حالة النظام
AI_BARS_15M=2000
AI_BARS_1H=500
AI_BARS_4H=300
AI_BARS_1D=260
# ضغط جسم الطلب بـ gzip: يبقى false حتى يفك ai-service الضغط عن الطلبات
AI_REQUEST_GZIP=false
# التقييم الدوري (B9، docs/ai-contract.md القسم 8): معطّل افتراضياً. عند كل حد 15 دقيقة تُجدوَل مهمة
# ai.evaluate لكل أداة وملف تداول بعد AI_EVALUATE_DELAY_SECONDS ثانية. intraday فقط في v1
AI_EVALUATE_ENABLED=false
AI_EVALUATE_INSTRUMENTS=fxpro:XAU/USD
AI_PROFILES=intraday
AI_EVALUATE_DELAY_SECONDS=20
# تحجيم إعدادات AI لكل مستخدم (B10، docs/risk-management.md): auto = ai-service ثم الحساب المحلي (B4)
# إذا لم يتوفر، remote = بلا بديل (503)، local = محلي دائماً. القيم الافتراضية حين لا يحددها ملف المخاطرة
AI_SIZE_MODE=auto
# 404 من /v1/size (لا يوجد بعد) = حساب محلي مع تحذير؛ يُطفأ (false) بعد P6 فيصبح 503
AI_SIZE_LOCAL_FALLBACK_ON_404=true
AI_SIZE_CONCURRENCY=4
AI_DEFAULT_RISK_PCT=1.0
AI_DEFAULT_DAILY_LOSS_PCT=3.0
AI_DEFAULT_MAX_DRAWDOWN_PCT=10.0
# تنبيهات إعدادات AI (B11، docs/notifications.md): صندوق صادر في نفس معاملة التقييم، ومُرسِل كل 30 ثانية.
# ARMED للمتابعين فقط وخلال 15 دقيقة، والحالات التالية لمن أخذ الصفقة فقط. الشرح من ai-service عند ARMED
AI_ALERTS_ENABLED=true
AI_ALERTS_BATCH=50
AI_ALERTS_MAX_ATTEMPTS=8
AI_ALERTS_MAX_AGE_SECONDS=900
AI_EXPLAIN_LANGS=ar,en
# إعادة إرسال الإشعارات العالقة (مهمة إرسال ضاعت بعد الحفظ): كل دقيقة، بعد 120 ثانية، 500 كحد أقصى
NOTIFICATION_SWEEP_AFTER_SECONDS=120
NOTIFICATION_SWEEP_BATCH=500
# أقدم من هذا (ثانية) لا يُرسل أبداً: يُعلَّم skipped (expired) بدل إرسال إشعار قديم
NOTIFICATION_SWEEP_MAX_AGE_SECONDS=86400
# أصول الويب المسموح لها (CORS). قيمة الإنتاج بعد تفعيل HTTPS (تُضبط يدوياً، docs/https.md):
# CORS_ORIGINS=https://trading.yazanalsamman.com,http://187.127.76.76:8080
CORS_ORIGINS=http://localhost:5173
# اسم الموقع العام عبر HTTPS (للتوثيق والروابط فقط؛ لا يعتمد عليه شيء حرج). ملف موقع nginx على السيرفر
# (infra/host-nginx/) يُولَّد بهذا الاسم، انظر docs/https.md
PUBLIC_HOSTNAME=trading.yazanalsamman.com

# شبكة Docker: عنوان Nginx الثابت هو الوحيد الموثوق لترويسة X-Forwarded-For (uvicorn --forwarded-allow-ips)
# غيّر الشبكة إن تعارضت مع شبكة أخرى على جهازك
DOCKER_SUBNET=172.30.57.0/24
NGINX_IP=172.30.57.10
# العناوين الديناميكية تأتي من هذا المجال فقط، فلا تأخذ أي حاوية عنوان Nginx (يجب أن يكون NGINX_IP خارجه)
DOCKER_IP_RANGE=172.30.57.128/25

# تحديد المعدل (Y08) — كل الحدود في الدقيقة؛ RATE_LIMIT_ENABLED=false يعطّله (الاختبارات)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRADER=60
RATE_LIMIT_ANALYST=300
RATE_LIMIT_EXPERT=300
RATE_LIMIT_ADMIN=1000
RATE_LIMIT_EXPENSIVE_COST=5
AUTH_LOGIN_IP_PER_MINUTE=10
AUTH_LOGIN_EMAIL_PER_MINUTE=5
AUTH_REGISTER_IP_PER_MINUTE=5
AUTH_REFRESH_IP_PER_MINUTE=30
LOGIN_LOCKOUT_FAILURES=10
LOGIN_LOCKOUT_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
WS_MAX_CONNECTIONS_PER_IDENTITY=5
WS_NEW_CONNECTIONS_IP_PER_MINUTE=20
API_KEY_LAST_USED_INTERVAL_SECONDS=60

# الإشعارات (Y15). القيم الفارغة تعني أن القناة معطّلة، والتطبيق يعمل عادياً.
# لا تضع الأسرار في git: تُضاف في ملف .env على السيرفر فقط (docs/notifications.md).
# Telegram: التوكن من @BotFather. الوضع polling لا يحتاج HTTPS (خدمة telegram-bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
# البريد: SMTP_HOST فارغ = معطّل
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Push (FCM HTTP v1): معرّف المشروع وملف service account (JSON في سطر واحد أو مسار ملف)
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=
# الأخبار (Y18): جلب RSS المدمج للمصادر العامة المفعّلة، كل 5 دقائق. مهلة 10 ثوانٍ وحد 2MB لكل خلاصة
NEWS_RSS_ENABLED=true
NEWS_FETCH_TIMEOUT_SECONDS=10
NEWS_FETCH_MAX_BYTES=2097152
NEWS_RETENTION_DAYS=180
# المنشورات والتعليقات (Y18): من يحق له النشر، وحدود الإنشاء لكل مستخدم
POST_ROLES=analyst,expert,admin
POST_EDIT_WINDOW_HOURS=24
POSTS_PER_DAY=10
COMMENTS_PER_HOUR=60
REPORTS_PER_DAY=20
CONTENT_CREATE_COST=2
# تنبيهات الأسعار (Y18): الحد الأقصى للتنبيهات النشطة لكل دور
PRICE_ALERT_LIMIT_TRADER=20
PRICE_ALERT_LIMIT_ANALYST=100
PRICE_ALERT_LIMIT_EXPERT=100
PRICE_ALERT_LIMIT_ADMIN=100
# الاشتراكات والدفع (Y19): دفع تجريبي فقط، لا أموال حقيقية ولا مفاتيح مزوّد حقيقي
PAYMENT_PROVIDER=demo
# فارغ = يُولَّد سرّ توقيع الـ webhook تلقائياً ويُحفظ في Redis
PAYMENT_DEMO_WEBHOOK_SECRET=
# أداة تقديم الوقت للمدير (fast-forward): معطّلة في الإنتاج إلا إذا كانت true
PAYMENT_DEMO_TOOLS=false
# إلى أين تعيد صفحة الدفع المتصفح (فارغ = صفحة النجاح في الـ API)
PAYMENT_RETURN_URL=
# العنوان العام لبناء روابط الدفع المطلقة، مثل http://187.127.76.76:8080 (فارغ = من عنوان الطلب Host).
# قيمة الإنتاج بعد تفعيل HTTPS (تُضبط يدوياً بعد عمل الموقع، docs/https.md):
# PUBLIC_BASE_URL=https://trading.yazanalsamman.com
PUBLIC_BASE_URL=
PLATFORM_FEE_PCT=20
SUBSCRIPTION_GRACE_DAYS=3
CHECKOUT_TTL_MINUTES=30
# المحادثة مع الخبراء (Y19)
CHAT_MESSAGES_PER_MINUTE=30
CHAT_MESSAGES_PER_DAY=2000
CHAT_EDIT_WINDOW_MINUTES=15
CHAT_NOTIFY_COLLAPSE_MINUTES=5
# السجلات: auto = JSON في الإنتاج (ENVIRONMENT=production) ونص عادي في التطوير؛ أو json / text
LOG_FORMAT=auto
# فارغ = تلقائي (مطفأ في الإنتاج)، true لتشغيل /docs يوم العرض، false لإطفائه دائماً
API_DOCS_ENABLED=
# اتصالات قاعدة البيانات لكل عملية (الـ API وكل عملية Celery). عند الضغط ينتظر الطلب
# DB_POOL_TIMEOUT ثانية ثم يحصل على 503 مع Retry-After بدل 500
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
# بوابة جودة البيانات (B5، docs/data-quality.md): فحص كل دقيقة للأدوات المذكورة (source:symbol
# مفصولة بفواصل). /api/v1/health/data يعيد 503 إذا كانت إحداها degraded أو no_data
DATA_QUALITY_ENABLED=true
DATA_QUALITY_INSTRUMENTS=fxpro:XAU/USD
DATA_QUALITY_MAX_LAG_SECONDS=120
DATA_QUALITY_MAX_MISSING_PCT=1.0
DATA_QUALITY_SPIKE_PCT=2.0
# تنبيه واحد على الأكثر للمدراء لكل أداة خلال هذه المدة (تذبذب ok/degraded)؛ الحالة نفسها تتغير فوراً
DATA_QUALITY_ALERT_COOLDOWN_SECONDS=1800
# التقويم الاقتصادي (B6، docs/economic-calendar.md): ملف ForexFactory الأسبوعي العام (بلا مفتاح)،
# طلب واحد كل 4 ساعات على الأكثر، وتوقف 6 ساعات بعد 429/403. العملات الافتراضية للقراءة ولـ B9
CALENDAR_ENABLED=true
CALENDAR_FF_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
CALENDAR_FETCH_INTERVAL_MINUTES=240
CALENDAR_FETCH_TIMEOUT_SECONDS=15
CALENDAR_FETCH_MAX_BYTES=2097152
CALENDAR_BACKOFF_HOURS=6
CALENDAR_CURRENCIES=USD
# عدد عمليات uvicorn في الـ backend: فارغ = 2 في الإنتاج (docker-compose.prod.yml) و1 في التطوير.
# (ليس WEB_CONCURRENCY: uvicorn يقرؤه بنفسه ويتعطل إذا كان فارغاً)
API_WORKERS=
