# انسخ هذا الملف إلى .env وعدّل القيم
ENVIRONMENT=development

POSTGRES_USER=trading
POSTGRES_PASSWORD=trading
POSTGRES_DB=trading
DATABASE_URL=postgresql+asyncpg://trading:trading@db:5432/trading
# منفذ المضيف لقاعدة البيانات و Redis (غيّره إن كان 5432/6379 مستخدماً على جهازك)
POSTGRES_PORT=5432
REDIS_PORT=6379

REDIS_URL=redis://redis:6379/0

# في الإنتاج (ENVIRONMENT=production) يجب أن يكون 32 حرفاً على الأقل وليس change-me
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# اختياري: يُنشأ هذا المدير عند الإقلاع إذا لم يوجد أي مدير
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

AI_SERVICE_URL=http://ai-service:8001
CORS_ORIGINS=http://localhost:5173
